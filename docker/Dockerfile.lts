# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS installer

ARG NPM_PACKAGE_NAME=pw2c-mssql-server-mcp
ARG NPM_PACKAGE_VERSION=latest

ENV NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

RUN npm install --global --prefix /opt/mcp "${NPM_PACKAGE_NAME}@${NPM_PACKAGE_VERSION}" \
    && npm cache clean --force

FROM node:22-alpine AS runtime

ENV NODE_ENV=production \
    PATH=/opt/mcp/bin:$PATH

COPY --from=installer /opt/mcp /opt/mcp
COPY docker/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["/entrypoint.sh"]
