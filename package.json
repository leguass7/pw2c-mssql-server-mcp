{
  "name": "pw2c-mssql-server-mcp",
  "version": "1.0.0",
  "description": "MCP server for SQL Server (MSSQL)",
  "license": "MIT",
  "author": "PW2C",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "pw2c-mssql-server-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mssql",
    "sql-server",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\" \"docs/**/*.md\"",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "mssql": "^11.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.19.22",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  }
}
